{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "block-kitchen-template",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // KV namespaces — run: pnpm run setup:kv, then paste IDs here
  "kv_namespaces": [
    {
      "binding": "SLACK_INSTALLATIONS",
      "id": "REPLACE_WITH_INSTALLATIONS_KV_ID"
    },
    {
      "binding": "SLACK_USER_INSTALLATIONS",
      "id": "REPLACE_WITH_USER_INSTALLATIONS_KV_ID"
    },
    {
      "binding": "SLACK_OAUTH_STATE",
      "id": "REPLACE_WITH_OAUTH_STATE_KV_ID"
    },
    {
      "binding": "SLACK_MODAL_VIEWS",
      "id": "REPLACE_WITH_MODAL_VIEWS_KV_ID"
    },
    {
      "binding": "SLACK_SESSIONS",
      "id": "REPLACE_WITH_SESSIONS_KV_ID"
    }
  ],

  // Rate limiting for the /api routes. Unlike KV, these need no setup step —
  // `namespace_id` is just a label you pick, unique within this Worker.
  // Starting points; tune them for your own traffic:
  //   API_RATE_LIMITER        — per client IP, every /api route
  //   SLACK_API_RATE_LIMITER  — per workspace, every route that calls Slack
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SLACK_API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // SPA assets — Vite builds the React client into dist/client/
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Non-secret env vars. Bot scopes for chat + channels + custom emoji
  // (emoji:read powers /api/slack/emojis); user scopes for "send as user".
  "vars": {
    "SLACK_BOT_SCOPES": "chat:write,channels:read,groups:read,emoji:read",
    "SLACK_USER_SCOPES": "chat:write,im:write"
  }

  // Set secrets via `pnpm run setup:secrets`:
  //   SLACK_SIGNING_SECRET
  //   SLACK_CLIENT_ID
  //   SLACK_CLIENT_SECRET
}
