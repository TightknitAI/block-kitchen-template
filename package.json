{
  "name": "block-kitchen-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Template app — Slack Block Kitchen UI on Cloudflare Workers, sending messages via @tightknitai/slack-hono.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:tunnel": "vite dev & cloudflared tunnel --config cloudflared.yml run & wait",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "setup:kv": "wrangler kv namespace create SLACK_INSTALLATIONS && wrangler kv namespace create SLACK_USER_INSTALLATIONS && wrangler kv namespace create SLACK_OAUTH_STATE && wrangler kv namespace create SLACK_MODAL_VIEWS && wrangler kv namespace create SLACK_SESSIONS",
    "setup:doctor": "bash scripts/doctor.sh",
    "setup:manifest": "bash scripts/setup-manifest.sh",
    "manifest:copy": "bash scripts/copy-manifest.sh",
    "setup:tunnel": "bash scripts/setup-tunnel.sh",
    "setup:secrets": "bash scripts/setup-secrets.sh",
    "install-app": "bash scripts/install-app.sh"
  },
  "dependencies": {
    "@tightknitai/block-kitchen": "0.10.12",
    "@tightknitai/slack-block-kit-validator": "0.1.20",
    "hono": "^4.13.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tightknitai/slack-hono": "^0.1.2",
    "slack-web-api-client": "^1.1.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.1": ">=7.29.1 <8.0.0",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8 <4.0.0",
      "prosemirror-view@<1.42.3": ">=1.42.3 <2.0.0",
      "sharp@<0.35.5": ">=0.35.5 <0.36.0",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2.0.0"
    }
  }
}
